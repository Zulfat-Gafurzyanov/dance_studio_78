# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dance_studio

# Copy to backend/.env and fill in:
# APP_NAME=78 Dance
# DEBUG=false
# LOGGING_LEVEL=INFO
# CORS_ORIGINS=["https://yourdomain.com"]
#
# DATABASE_URL=postgresql://postgres:changeme@postgres:5432/dance_studio
# DATABASE_URL_SQLALCHEMY=postgresql+asyncpg://postgres:changeme@postgres:5432/dance_studio
# DB_SCHEMA=public
# DB_MIN_POOL_SIZE=5
# DB_MAX_POOL_SIZE=20
#
# REDIS_URL=redis://redis:6379/0
#
# JWT_PRIVATE_KEY_PATH=keys/private.pem
# JWT_PUBLIC_KEY_PATH=keys/public.pem
# JWT_ALGORITHM=RS256
# ACCESS_TOKEN_LIFETIME=3600
# REFRESH_TOKEN_LIFETIME=604800
#
# ENABLE_METRICS=false
